{
  "name": "puzzleloo",
  "private": true,
  "version": "1.0.0",
  "description": "PuzzleLoo – a neon connect-the-shapes logic puzzle game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/render-assets.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor '#1a0b3d' --splashBackgroundColor '#1a0b3d'"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
